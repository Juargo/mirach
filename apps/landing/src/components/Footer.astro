---
import { PRIVACY, SUPPORT, ACCOUNT_DELETION } from '../config';
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-surface-container-high bg-surface px-6 py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-4 sm:flex-row sm:justify-between"
  >
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-body-sm text-on-surface-variant" aria-label="Legal">
      <a
        href={PRIVACY.url}
        class="transition-colors hover:text-on-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {PRIVACY.label}
      </a>
      <a
        href={SUPPORT.url}
        class="transition-colors hover:text-on-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {SUPPORT.label}
      </a>
      <a
        href={ACCOUNT_DELETION.url}
        class="transition-colors hover:text-on-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {ACCOUNT_DELETION.label}
      </a>
    </nav>
    <p class="text-body-sm text-on-surface-variant">
      &copy; {year} Mirach. Todos los derechos reservados.
    </p>
  </div>
</footer>
