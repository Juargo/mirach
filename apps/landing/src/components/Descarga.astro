---
import AppStoreCta from './AppStoreCta.astro';
---

<section id="descarga" data-reveal class="scroll-mt-20 px-6 py-16 text-center sm:py-24">
  <h2
    class="font-display mx-auto max-w-2xl text-balance text-headline-lg font-bold leading-[1.05] tracking-tight text-on-surface sm:text-4xl md:text-5xl"
  >
    Sube tu cartola y mira cómo va tu mes
  </h2>
  <p class="mx-auto mt-4 max-w-md text-body-lg leading-relaxed text-on-surface-variant">
    Mirach para iPhone, con iOS 17 o superior.
  </p>
  <div class="mt-8">
    <AppStoreCta />
  </div>
</section>
