---
export interface Bank {
  name: string;
  svg: string;
  /** Intrinsic size of the logo file, to reserve its space before it loads. */
  width: number;
  height: number;
  /** Display height. The wordmarks differ in proportion, so each one is
      sized by eye to carry the same visual weight. */
  size: string;
}

// Official wordmarks, from Wikimedia Commons (public domain as simple text
// logos; they remain trademarks of each bank).
const banks: Bank[] = [
  { name: 'BancoEstado', svg: '/images/banks/bancoestado.svg', width: 512, height: 100, size: 'h-8' },
  { name: 'Banco de Chile', svg: '/images/banks/chile.svg', width: 1000, height: 199, size: 'h-7' },
  { name: 'Bci', svg: '/images/banks/bci.svg', width: 65, height: 30, size: 'h-10' },
  { name: 'Santander', svg: '/images/banks/santander.svg', width: 238, height: 42, size: 'h-7' },
];
---

<section id="bancos" data-reveal class="scroll-mt-20 px-6 py-16 sm:py-24">
  <h2
    class="font-display text-center text-headline-lg font-bold leading-[1.05] tracking-tight text-on-surface sm:text-4xl md:text-5xl"
  >
    Bancos compatibles
  </h2>

  <p
    class="mx-auto mt-4 max-w-md text-center text-body-sm text-on-surface-variant"
  >
    Trabajamos con los bancos más usados en Chile. ¿Falta el tuyo?
    Escríbenos y lo agregamos.
  </p>

  <ul class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-4 md:grid-cols-4">
    {banks.map((bank) => (
      <li class="flex h-24 items-center justify-center rounded border border-outline-variant/60 bg-surface-container-lowest px-5">
        <img
          src={bank.svg}
          alt={bank.name}
          width={bank.width}
          height={bank.height}
          class:list={[bank.size, 'w-auto max-w-full object-contain']}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))}
  </ul>

  <p class="mx-auto mt-6 max-w-md text-center text-label-caps leading-relaxed text-on-surface-variant">
    Las marcas y logotipos pertenecen a cada banco. Mirach no está afiliada a
    ninguno de ellos.
  </p>
</section>
