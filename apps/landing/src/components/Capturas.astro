---
const screenshots = [
  {
    src: '/images/screenshots/resumen.webp',
    alt: 'Resumen mensual de MoneyDiary con el semáforo financiero y la distribución del gasto en Necesidades, Gustos y Ahorro frente al ideal 50/30/20',
  },
  {
    src: '/images/screenshots/subir-cartola.webp',
    alt: 'Subida de una cartola en MoneyDiary: el banco se detecta automáticamente y se muestra una vista previa antes de importar',
  },
  {
    src: '/images/screenshots/movimientos-por-categoria.webp',
    alt: 'Vista previa de una cartola en MoneyDiary con los movimientos agrupados por bucket y categoría',
  },
];
---

<section id="capturas" data-reveal class="bg-surface-dim/50 px-6 py-16 sm:py-24">
  <h2
    class="font-display text-center text-headline-lg font-bold leading-[1.05] tracking-tight text-on-surface sm:text-4xl md:text-5xl"
  >
    Así se ve MoneyDiary
  </h2>

  <p class="mx-auto mt-4 max-w-2xl text-center text-body-sm text-on-surface-variant">
    Una interfaz limpia y moderna que te ayuda a entender tus finanzas de
    un vistazo.
  </p>

  <div class="mx-auto mt-10 grid max-w-6xl gap-6 sm:grid-cols-2 md:grid-cols-3">
    {screenshots.map((s) => (
      <div
        class="flex aspect-[9/16] items-center justify-center card-lift overflow-hidden rounded-xl bg-surface-container-highest shadow-soft"
      >
        <img
          src={s.src}
          alt={s.alt}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</section>
