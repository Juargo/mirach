---
import { FAQ_ITEMS } from '../config';
---

<section id="faq" data-reveal class="scroll-mt-20 bg-surface-dim/50 px-6 py-16 sm:py-24">
  <h2
    class="font-display text-center text-headline-lg font-bold leading-[1.05] tracking-tight text-on-surface sm:text-4xl md:text-5xl"
  >
    Preguntas frecuentes
  </h2>

  <div class="mx-auto mt-10 max-w-2xl divide-y divide-outline-variant">
    {FAQ_ITEMS.map((item) => (
      <details class="group py-3">
        <summary
          class="flex cursor-pointer items-center justify-between gap-4 py-2 text-title-md font-medium text-on-surface transition-colors hover:text-primary [&::-webkit-details-marker]:hidden list-none"
        >
          {item.q}
          <svg
            class="size-5 shrink-0 text-on-surface-variant transition-transform duration-200 group-open:rotate-180"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 7.5 5 5 5-5" />
          </svg>
        </summary>
        <div class="pb-2 text-body-sm leading-relaxed text-on-surface-variant">
          {item.a}
        </div>
      </details>
    ))}
  </div>
</section>
