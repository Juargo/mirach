{
  "components": {
    "schemas": {
      "AuthMeResponse": {
        "additionalProperties": false,
        "description": "GET /api/auth/me — the authenticated user identity (AUTH-09).",
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null only for esDemo=true (demo) accounts — a domain invariant, not enforced by this schema."
          },
          "esDemo": {
            "type": "boolean"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "esDemo",
          "email"
        ],
        "type": "object"
      },
      "DetalleBucketResponse": {
        "additionalProperties": false,
        "description": "GET /api/buckets/:bucket — bucket drill-down (US-017).",
        "properties": {
          "bucket": {
            "description": "Validated bucket name (echo, not raw input).",
            "type": "string"
          },
          "periodo": {
            "description": "Resolved period, format YYYY-MM.",
            "type": "string"
          },
          "transacciones": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "abono": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "banco": {
                  "type": "string"
                },
                "cargo": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "categoria": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "nombre": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "nombre"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Folded category, or null for Ingreso/SinCategoria rows."
                },
                "descripcion": {
                  "type": "string"
                },
                "fecha": {
                  "description": "ISO-8601 UTC timestamp.",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "numeroCuenta": {
                  "type": "string"
                },
                "tipoCuenta": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "fecha",
                "descripcion",
                "cargo",
                "abono",
                "banco",
                "tipoCuenta",
                "numeroCuenta",
                "categoria"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "periodo",
          "bucket",
          "transacciones"
        ],
        "type": "object"
      },
      "IngestasListResponse": {
        "additionalProperties": false,
        "description": "GET /api/ingestas — per-user ingesta list (US-004/US-018).",
        "properties": {
          "ingestas": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "banco": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "null when an early FALLIDA ingesta never resolved a bank."
                },
                "estado": {
                  "enum": [
                    "PROCESADA",
                    "FALLIDA"
                  ],
                  "type": "string"
                },
                "fecha": {
                  "description": "ISO-8601 UTC timestamp.",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "motivoFallo": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "nombreArchivo": {
                  "type": "string"
                },
                "totalTransacciones": {
                  "description": "Row count, not money — plain JSON number.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "banco",
                "nombreArchivo",
                "estado",
                "motivoFallo",
                "fecha",
                "totalTransacciones"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "ingestas"
        ],
        "type": "object"
      },
      "IngestaUploadResponse": {
        "additionalProperties": false,
        "description": "POST /api/ingestas — successful upload result (US-004/US-005/US-011).",
        "properties": {
          "archivo": {
            "additionalProperties": false,
            "properties": {
              "extension": {
                "type": "string"
              },
              "nombre": {
                "type": "string"
              },
              "tamanoBytes": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "nombre",
              "extension",
              "tamanoBytes"
            ],
            "type": "object"
          },
          "banco": {
            "type": "string"
          },
          "duplicadosOmitidos": {
            "description": "Count of rows skipped as duplicates. Never omitted (CA-04).",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "ingestaId": {
            "type": "string"
          },
          "numeroCuenta": {
            "type": "string"
          },
          "tipoCuenta": {
            "type": "string"
          },
          "totalTransacciones": {
            "description": "Row count, not money — plain JSON number.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "transacciones": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "abono": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "cargo": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "descripcion": {
                  "type": "string"
                },
                "fecha": {
                  "description": "ISO-8601 UTC timestamp.",
                  "type": "string"
                }
              },
              "required": [
                "fecha",
                "descripcion",
                "cargo",
                "abono"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "ingestaId",
          "banco",
          "tipoCuenta",
          "numeroCuenta",
          "archivo",
          "totalTransacciones",
          "duplicadosOmitidos",
          "transacciones"
        ],
        "type": "object"
      },
      "MovimientosMesResponse": {
        "additionalProperties": false,
        "description": "GET /api/movimientos — monthly transaction list (US-014).",
        "properties": {
          "periodo": {
            "description": "Resolved period, format YYYY-MM.",
            "type": "string"
          },
          "totalTransacciones": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "transacciones": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "abono": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "banco": {
                  "type": "string"
                },
                "bucket": {
                  "description": "Bucket name (Bucket domain enum value).",
                  "type": "string"
                },
                "cargo": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "categoria": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "nombre": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "nombre"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Folded category, or null for Ingreso/SinCategoria rows."
                },
                "descripcion": {
                  "type": "string"
                },
                "fecha": {
                  "description": "ISO-8601 UTC timestamp.",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "numeroCuenta": {
                  "type": "string"
                },
                "tipoCuenta": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "fecha",
                "descripcion",
                "cargo",
                "abono",
                "banco",
                "tipoCuenta",
                "numeroCuenta",
                "bucket",
                "categoria"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "periodo",
          "totalTransacciones",
          "transacciones"
        ],
        "type": "object"
      },
      "PreviewIngestaResponse": {
        "additionalProperties": false,
        "description": "POST /api/ingestas/preview — dry-run sample of a would-be upload (US-003).",
        "properties": {
          "banco": {
            "type": "string"
          },
          "estructura": {
            "additionalProperties": false,
            "properties": {
              "totalFilasDatos": {
                "description": "Row count PRE-dedupe, not money — plain JSON number.",
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "totalFilasDatos"
            ],
            "type": "object"
          },
          "muestra": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "abono": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "cargo": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "descripcion": {
                  "type": "string"
                },
                "fecha": {
                  "description": "ISO-8601 UTC timestamp.",
                  "type": "string"
                }
              },
              "required": [
                "fecha",
                "descripcion",
                "cargo",
                "abono"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "numeroCuenta": {
            "type": "string"
          },
          "tipoCuenta": {
            "type": "string"
          }
        },
        "required": [
          "banco",
          "tipoCuenta",
          "numeroCuenta",
          "estructura",
          "muestra"
        ],
        "type": "object"
      },
      "ResumenAnualResponse": {
        "additionalProperties": false,
        "description": "GET /api/resumen/anual — 50/30/20 annual breakdown (US-030).",
        "properties": {
          "anio": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "meses": {
            "description": "Always 12 entries, Enero→Diciembre.",
            "items": {
              "$ref": "#/components/schemas/ResumenMesResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "anio",
          "meses"
        ],
        "type": "object"
      },
      "ResumenMesResponse": {
        "additionalProperties": false,
        "description": "GET /api/resumen — 50/30/20 monthly breakdown (US-015/016).",
        "properties": {
          "buckets": {
            "description": "Always 4 entries: Necesidades, Deseos, Ahorro, SinCategoria.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "bucket": {
                  "description": "Bucket name (Bucket domain enum value).",
                  "type": "string"
                },
                "estadoSemaforo": {
                  "anyOf": [
                    {
                      "enum": [
                        "verde",
                        "amarillo",
                        "rojo"
                      ],
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Traffic-light health state, lowercase wire enum (US-016), or null."
                },
                "porcentajeBp": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Basis-point percentage (0-10000). null when sinIngreso=true."
                },
                "total": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                }
              },
              "required": [
                "bucket",
                "total",
                "porcentajeBp",
                "estadoSemaforo"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "estadoGlobal": {
            "anyOf": [
              {
                "enum": [
                  "verde",
                  "amarillo",
                  "rojo"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Worst traffic-light state across measured buckets, or null."
          },
          "periodo": {
            "description": "Resolved period, format YYYY-MM.",
            "type": "string"
          },
          "sinIngreso": {
            "type": "boolean"
          },
          "targets": {
            "additionalProperties": false,
            "description": "Hardcoded 50/30/20 reference targets.",
            "properties": {
              "Ahorro": {
                "type": "number"
              },
              "Deseos": {
                "type": "number"
              },
              "Necesidades": {
                "type": "number"
              }
            },
            "required": [
              "Necesidades",
              "Deseos",
              "Ahorro"
            ],
            "type": "object"
          },
          "totalIngreso": {
            "description": "BigInt-safe decimal string amount (never a JSON number).",
            "type": "string"
          }
        },
        "required": [
          "periodo",
          "totalIngreso",
          "sinIngreso",
          "buckets",
          "targets",
          "estadoGlobal"
        ],
        "type": "object"
      },
      "VersionResponse": {
        "additionalProperties": false,
        "description": "Deployed build info for the API — GET /version.",
        "properties": {
          "builtAt": {
            "description": "ISO-8601 timestamp of when this process booted.",
            "type": "string"
          },
          "commit": {
            "description": "Short commit SHA, or \"local\" outside Render.",
            "type": "string"
          },
          "ref": {
            "description": "Git branch/ref, or \"local\" outside Render.",
            "type": "string"
          },
          "version": {
            "description": "Package version (release-please, ADR-030).",
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit",
          "ref",
          "builtAt"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "HTTP contract for the MoneyDiary Express API, sourced from Zod schemas (ADR-011 amend).",
    "title": "MoneyDiary API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/demo": {
      "get": {
        "description": "Public endpoint (requires x-api-key only) that creates a demo account or resumes an existing valid session, then redirects. No JSON response body — the session is conveyed via the `md_session` cookie (Set-Cookie) and the redirect target.",
        "responses": {
          "302": {
            "description": "Session established (new demo or resumed existing); redirects to the app root.",
            "headers": {
              "Location": {
                "description": "Always \"/\" — the app root.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Rejected: request is not a top-level navigation (anti-embed Fetch-Metadata guard)."
          },
          "429": {
            "description": "Rate-limited: too many demo requests from this IP."
          }
        },
        "summary": "Create or resume a demo session"
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "Authenticated endpoint returning the identity of the current session (AUTH-09, DEMO-AUTH-05). Requires x-api-key + a valid session.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMeResponse"
                }
              }
            },
            "description": "Identity of the authenticated session."
          },
          "401": {
            "description": "No valid session (missing, expired, or invalid token)."
          }
        },
        "summary": "Current session identity"
      }
    },
    "/api/buckets/{bucket}": {
      "get": {
        "description": "Authenticated endpoint returning the transaction detail for a single spend bucket (US-017). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "parameters": [
          {
            "description": "Bucket name (raw path param). Validated against the domain enum by the use case, not this schema.",
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "description": "Bucket name (raw path param). Validated against the domain enum by the use case, not this schema.",
              "type": "string"
            }
          },
          {
            "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
            "in": "query",
            "name": "periodo",
            "schema": {
              "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetalleBucketResponse"
                }
              }
            },
            "description": "Bucket detail for the resolved period."
          },
          "400": {
            "description": "Invalid bucket (unrecognized value) or invalid periodo — both domain-level (BucketInvalidoError / PeriodoInvalidoError)."
          }
        },
        "summary": "Bucket drill-down"
      }
    },
    "/api/ingestas": {
      "get": {
        "description": "Authenticated endpoint returning the per-user ingesta history (US-004/US-018). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestasListResponse"
                }
              }
            },
            "description": "Ingesta list for the authenticated user."
          }
        },
        "summary": "List ingestas"
      },
      "post": {
        "description": "Authenticated endpoint that detects the bank, validates structure, normalizes, persists, and categorizes a bank statement file (US-004/US-005/US-011). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "contentEncoding": "binary",
                    "description": "Bank statement file (.xlsx or .pdf). Extension/bank-format validation is a domain rule (ExtensionNoPermitidaError / BancoNoReconocidoError), not this schema.",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestaUploadResponse"
                }
              }
            },
            "description": "Upload processed and persisted."
          },
          "400": {
            "description": "Invalid file — missing file field, disallowed extension, unrecognized bank, invalid structure/normalization, or an oversized file (>10 MB)."
          },
          "500": {
            "description": "Persistence failure (infrastructure fault, not the uploaded file)."
          }
        },
        "summary": "Upload a bank statement"
      }
    },
    "/api/ingestas/{id}": {
      "delete": {
        "description": "Authenticated endpoint that cascade-deletes an ingesta and its transactions (US-018, ING-01/ING-02). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "parameters": [
          {
            "description": "Ingesta id (raw path param). Existence/ownership is checked by the use case, not this schema.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Ingesta id (raw path param). Existence/ownership is checked by the use case, not this schema.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Ingesta deleted. No response body."
          },
          "404": {
            "description": "Anti-enumeration: the ingesta does not exist or does not belong to the authenticated user."
          }
        },
        "summary": "Delete an ingesta"
      }
    },
    "/api/ingestas/preview": {
      "post": {
        "description": "Authenticated endpoint that detects the bank, validates structure, and normalizes a sample of a would-be upload WITHOUT persisting anything (US-003). Requires x-api-key + a valid session; the result itself is not scoped by user (no tenant data is touched).",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "contentEncoding": "binary",
                    "description": "Bank statement file (.xlsx or .pdf). Extension/bank-format validation is a domain rule (ExtensionNoPermitidaError / BancoNoReconocidoError), not this schema.",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewIngestaResponse"
                }
              }
            },
            "description": "Preview sample computed (not persisted)."
          },
          "400": {
            "description": "Invalid file — missing file field, disallowed extension, unrecognized bank, invalid structure/normalization, or an oversized file (>10 MB)."
          }
        },
        "summary": "Preview a bank statement (dry run)"
      }
    },
    "/api/movimientos": {
      "get": {
        "description": "Authenticated endpoint returning the consolidated monthly transaction list (US-014). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "parameters": [
          {
            "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
            "in": "query",
            "name": "periodo",
            "schema": {
              "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovimientosMesResponse"
                }
              }
            },
            "description": "Monthly transaction list for the resolved period."
          },
          "400": {
            "description": "Invalid periodo — either a transport-shape mismatch or a malformed YYYY-MM value (domain-level, PeriodoMes VO)."
          }
        },
        "summary": "Monthly transaction list"
      }
    },
    "/api/resumen": {
      "get": {
        "description": "Authenticated endpoint returning the 50/30/20 budget breakdown for a month (US-015/016). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "parameters": [
          {
            "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
            "in": "query",
            "name": "periodo",
            "schema": {
              "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumenMesResponse"
                }
              }
            },
