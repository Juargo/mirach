{
  "components": {
    "schemas": {
      "DetalleBucketResponse": {
        "additionalProperties": false,
        "description": "GET /api/buckets/:bucket — bucket drill-down (US-017).",
        "properties": {
          "bucket": {
            "description": "Validated bucket name (echo, not raw input).",
            "type": "string"
          },
          "periodo": {
            "description": "Resolved period, format YYYY-MM.",
            "type": "string"
          },
          "transacciones": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "abono": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "banco": {
                  "type": "string"
                },
                "cargo": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "categoria": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "nombre": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "nombre"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Folded category, or null for Ingreso/SinCategoria rows."
                },
                "descripcion": {
                  "type": "string"
                },
                "fecha": {
                  "description": "ISO-8601 UTC timestamp.",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "numeroCuenta": {
                  "type": "string"
                },
                "tipoCuenta": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "fecha",
                "descripcion",
                "cargo",
                "abono",
                "banco",
                "tipoCuenta",
                "numeroCuenta",
                "categoria"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "periodo",
          "bucket",
          "transacciones"
        ],
        "type": "object"
      },
      "IngestasListResponse": {
        "additionalProperties": false,
        "description": "GET /api/ingestas — per-user ingesta list (US-004/US-018).",
        "properties": {
          "ingestas": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "banco": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "null when an early FALLIDA ingesta never resolved a bank."
                },
                "estado": {
                  "enum": [
                    "PROCESADA",
                    "FALLIDA"
                  ],
                  "type": "string"
                },
                "fecha": {
                  "description": "ISO-8601 UTC timestamp.",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "motivoFallo": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "nombreArchivo": {
                  "type": "string"
                },
                "totalTransacciones": {
                  "description": "Row count, not money — plain JSON number.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "banco",
                "nombreArchivo",
                "estado",
                "motivoFallo",
                "fecha",
                "totalTransacciones"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "ingestas"
        ],
        "type": "object"
      },
      "MovimientosMesResponse": {
        "additionalProperties": false,
        "description": "GET /api/movimientos — monthly transaction list (US-014).",
        "properties": {
          "periodo": {
            "description": "Resolved period, format YYYY-MM.",
            "type": "string"
          },
          "totalTransacciones": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "transacciones": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "abono": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "banco": {
                  "type": "string"
                },
                "bucket": {
                  "description": "Bucket name (Bucket domain enum value).",
                  "type": "string"
                },
                "cargo": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                },
                "categoria": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "nombre": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "nombre"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Folded category, or null for Ingreso/SinCategoria rows."
                },
                "descripcion": {
                  "type": "string"
                },
                "fecha": {
                  "description": "ISO-8601 UTC timestamp.",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "numeroCuenta": {
                  "type": "string"
                },
                "tipoCuenta": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "fecha",
                "descripcion",
                "cargo",
                "abono",
                "banco",
                "tipoCuenta",
                "numeroCuenta",
                "bucket",
                "categoria"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "periodo",
          "totalTransacciones",
          "transacciones"
        ],
        "type": "object"
      },
      "ResumenAnualResponse": {
        "additionalProperties": false,
        "description": "GET /api/resumen/anual — 50/30/20 annual breakdown (US-030).",
        "properties": {
          "anio": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "meses": {
            "description": "Always 12 entries, Enero→Diciembre.",
            "items": {
              "$ref": "#/components/schemas/ResumenMesResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "anio",
          "meses"
        ],
        "type": "object"
      },
      "ResumenMesResponse": {
        "additionalProperties": false,
        "description": "GET /api/resumen — 50/30/20 monthly breakdown (US-015/016).",
        "properties": {
          "buckets": {
            "description": "Always 4 entries: Necesidades, Deseos, Ahorro, SinCategoria.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "bucket": {
                  "description": "Bucket name (Bucket domain enum value).",
                  "type": "string"
                },
                "estadoSemaforo": {
                  "anyOf": [
                    {
                      "enum": [
                        "verde",
                        "amarillo",
                        "rojo"
                      ],
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Traffic-light health state, lowercase wire enum (US-016), or null."
                },
                "porcentajeBp": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Basis-point percentage (0-10000). null when sinIngreso=true."
                },
                "total": {
                  "description": "BigInt-safe decimal string amount (never a JSON number).",
                  "type": "string"
                }
              },
              "required": [
                "bucket",
                "total",
                "porcentajeBp",
                "estadoSemaforo"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "estadoGlobal": {
            "anyOf": [
              {
                "enum": [
                  "verde",
                  "amarillo",
                  "rojo"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Worst traffic-light state across measured buckets, or null."
          },
          "periodo": {
            "description": "Resolved period, format YYYY-MM.",
            "type": "string"
          },
          "sinIngreso": {
            "type": "boolean"
          },
          "targets": {
            "additionalProperties": false,
            "description": "Hardcoded 50/30/20 reference targets.",
            "properties": {
              "Ahorro": {
                "type": "number"
              },
              "Deseos": {
                "type": "number"
              },
              "Necesidades": {
                "type": "number"
              }
            },
            "required": [
              "Necesidades",
              "Deseos",
              "Ahorro"
            ],
            "type": "object"
          },
          "totalIngreso": {
            "description": "BigInt-safe decimal string amount (never a JSON number).",
            "type": "string"
          }
        },
        "required": [
          "periodo",
          "totalIngreso",
          "sinIngreso",
          "buckets",
          "targets",
          "estadoGlobal"
        ],
        "type": "object"
      },
      "VersionResponse": {
        "additionalProperties": false,
        "description": "Deployed build info for the API — GET /version.",
        "properties": {
          "builtAt": {
            "description": "ISO-8601 timestamp of when this process booted.",
            "type": "string"
          },
          "commit": {
            "description": "Short commit SHA, or \"local\" outside Render.",
            "type": "string"
          },
          "ref": {
            "description": "Git branch/ref, or \"local\" outside Render.",
            "type": "string"
          },
          "version": {
            "description": "Package version (release-please, ADR-030).",
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit",
          "ref",
          "builtAt"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "HTTP contract for the MoneyDiary Express API, sourced from Zod schemas (ADR-011 amend).",
    "title": "MoneyDiary API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/buckets/{bucket}": {
      "get": {
        "description": "Authenticated endpoint returning the transaction detail for a single spend bucket (US-017). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "parameters": [
          {
            "description": "Bucket name (raw path param). Validated against the domain enum by the use case, not this schema.",
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "description": "Bucket name (raw path param). Validated against the domain enum by the use case, not this schema.",
              "type": "string"
            }
          },
          {
            "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
            "in": "query",
            "name": "periodo",
            "schema": {
              "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetalleBucketResponse"
                }
              }
            },
            "description": "Bucket detail for the resolved period."
          },
          "400": {
            "description": "Invalid bucket (unrecognized value) or invalid periodo — both domain-level (BucketInvalidoError / PeriodoInvalidoError)."
          }
        },
        "summary": "Bucket drill-down"
      }
    },
    "/api/ingestas": {
      "get": {
        "description": "Authenticated endpoint returning the per-user ingesta history (US-004/US-018). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestasListResponse"
                }
              }
            },
            "description": "Ingesta list for the authenticated user."
          }
        },
        "summary": "List ingestas"
      }
    },
    "/api/movimientos": {
      "get": {
        "description": "Authenticated endpoint returning the consolidated monthly transaction list (US-014). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "parameters": [
          {
            "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
            "in": "query",
            "name": "periodo",
            "schema": {
              "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovimientosMesResponse"
                }
              }
            },
            "description": "Monthly transaction list for the resolved period."
          },
          "400": {
            "description": "Invalid periodo — either a transport-shape mismatch or a malformed YYYY-MM value (domain-level, PeriodoMes VO)."
          }
        },
        "summary": "Monthly transaction list"
      }
    },
    "/api/resumen": {
      "get": {
        "description": "Authenticated endpoint returning the 50/30/20 budget breakdown for a month (US-015/016). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "parameters": [
          {
            "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
            "in": "query",
            "name": "periodo",
            "schema": {
              "description": "Month period, format YYYY-MM (e.g. 2026-07). Absent defaults to the current month. Format is validated by the domain, not this schema.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumenMesResponse"
                }
              }
            },
            "description": "Monthly resumen for the resolved period."
          },
          "400": {
            "description": "Invalid periodo — either a transport-shape mismatch or a malformed YYYY-MM value (domain-level, PeriodoMes VO)."
          }
        },
        "summary": "Monthly 50/30/20 breakdown"
      }
    },
    "/api/resumen/anual": {
      "get": {
        "description": "Authenticated endpoint returning the 50/30/20 budget breakdown for all 12 months of a year (US-030). Requires x-api-key + a valid session (RNF-SEC-006, per-user isolation).",
        "parameters": [
          {
            "description": "Year, e.g. 2026. Absent defaults to the current year. Range/format is validated by the domain, not this schema.",
            "in": "query",
            "name": "anio",
            "schema": {
              "description": "Year, e.g. 2026. Absent defaults to the current year. Range/format is validated by the domain, not this schema.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumenAnualResponse"
                }
              }
            },
            "description": "Annual resumen for the resolved year."
          },
          "400": {
            "description": "Invalid anio — either a transport-shape mismatch or a malformed/out-of-range value (domain-level)."
          }
        },
        "summary": "Annual 50/30/20 breakdown"
      }
    },
    "/version": {
      "get": {
        "description": "Public, unauthenticated endpoint exposing the currently deployed build (ADR-030).",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Build info for the currently deployed API instance."
          }
        },
        "summary": "Deployed build info"
      }
    }
  }
}
