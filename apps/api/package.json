{
  "name": "@mirach/api",
  "version": "0.11.0",
  "description": "Mirach backend — Express + Clean Architecture, pipeline de ingesta de movimientos bancarios.",
  "author": "Juargo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "tsx src/infrastructure/http-express/server.ts",
    "dev": "tsx watch src/infrastructure/http-express/server.ts",
    "start:prod": "node dist/infrastructure/http-express/server",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "DOTENV_CONFIG_PATH=.env.test ALLOW_DESTRUCTIVE_DB=1 vitest run --config ./vitest.e2e.config.ts",
    "test:integration": "DOTENV_CONFIG_PATH=.env.test ALLOW_DESTRUCTIVE_DB=1 vitest run --config ./vitest.int.config.ts",
    "test:db:migrate": "DOTENV_CONFIG_PATH=.env.test prisma migrate deploy",
    "test:db:seed": "DOTENV_CONFIG_PATH=.env.test ALLOW_DESTRUCTIVE_DB=1 tsx prisma/seed.ts",
    "test:db:setup": "pnpm test:db:migrate && pnpm test:db:seed",
    "us037:rehearsal": "DOTENV_CONFIG_PATH=.env.test ALLOW_DESTRUCTIVE_DB=1 tsx prisma/rehearsals/us037-catalogo-rehearsal.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "cli": "tsx src/infrastructure/cli/ingestar.ts",
    "env:example": "tsx scripts/gen-env-example.ts",
    "env:example:check": "tsx scripts/gen-env-example.ts --check",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "openapi:check": "tsx scripts/emit-openapi.ts --check",
    "dast:token": "tsx scripts/dast-readiness.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "jose": "6.2.8",
    "multer": "^2.4.0",
    "openid-client": "6.8.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
