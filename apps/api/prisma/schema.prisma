datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum EstadoIngesta {
  PENDIENTE
  PROCESADA
  FALLIDA
}

model User {
  id            String    @id @default(cuid())
  nombre        String
  // US-035: email cifrado en reposo (AES-GCM, ADR-013). Deja de ser @unique
  // porque el IV aleatorio hace que dos cifrados del mismo email difieran.
  email         String?
  // Blind index (HMAC-SHA256 determinístico sobre el email normalizado) — la
  // unicidad y la búsqueda por igualdad (login) se hacen acá. Nullable: los
  // usuarios demo no tienen email (múltiples NULL permitidos por Postgres).
  emailBlindIndex String? @unique
  passwordHash  String?
  // auth-google-login (AUTH-14, slice A): identificador OIDC opaco de
  // Google (`sub`), cleartext — no es PII legible y debe ser @unique, lo que
  // el cifrado no-determinístico de ADR-013 prohibiría. Nullable: la mayoría
  // de los usuarios no tienen login con Google. Additive-only: filas
  // existentes quedan en NULL.
  googleSub     String?   @unique
  esDemo        Boolean   @default(false)
  demoCreatedAt DateTime?
  creadoEn      DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  // US-004: historial de ingestas — aislamiento directo por userId,
  // independiente de accountId (que ahora puede ser null en fallas
  // tempranas, ver Ingesta más abajo).
  ingestas      Ingesta[]
  // US-037: catálogo de clasificación per-user (copy-on-signup). NO hay
  // `patrones PatronClasificacion[]` back-relation deliberadamente — ver
  // design.md D-06: evita un scalar field compartido por dos relaciones
  // Prisma a la vez (el riesgo real del composite FK). `userId` sigue
  // siendo un scalar de relación normal en PatronClasificacion, así que los
  // filtros `where: { userId }` funcionan igual sin esta navegación.
  categorias    Categoria[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  creadoEn  DateTime @default(now())

  @@index([userId])
}

model Account {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  banco         String
  tipoCuenta    String
  // US-035 Slice 2: numeroCuenta cifrado en reposo (AES-GCM, ADR-013).
  numeroCuenta  String
  // Blind index (HMAC determinístico sobre numeroCuenta normalizado) — la
  // clave natural del upsert de ingesta se muda acá porque el IV aleatorio del
  // cifrado no es único ni matcheable. Nullable SOLO durante la ventana de
  // migración/backfill: en la práctica lo pobla siempre ensure()/demo/seed.
  numeroCuentaBlindIndex String?
  creadoEn      DateTime      @default(now())
  ingestas      Ingesta[]
  transacciones Transaccion[]

  @@unique([userId, banco, tipoCuenta, numeroCuentaBlindIndex])
}

model Ingesta {
  id                 String        @id @default(cuid())
  // US-004: userId es el aislamiento AUTORITATIVO (RNF-SEC-006) — el único
  // que puede aislar una fila FALLIDA sin account (accountId null abajo).
  // NOT NULL: toda Ingesta (éxito o fallo) pertenece a un usuario
  // autenticado (design.md §5.1).
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  // US-004: relajado a nullable — una FALLIDA temprana (extensión inválida,
  // banco no reconocido) no tiene cuenta resuelta. Invariante
  // `estado = PROCESADA ⟹ accountId NOT NULL` se enforce en application
  // (single-writer, persistirProcesada) + CHECK en BD (raw SQL, ver
  // migración) — Prisma no modela CHECK.
  accountId          String?
  // `onDelete: Restrict` explícito: la BD deployada tiene el FK con RESTRICT
  // (migración 20260710175729, previa a US-004) y el default de Prisma para
  // una relación opcional es SetNull — sin el pin, todo `migrate dev` detecta
  // drift y regenera una migración que nadie pidió. SetNull además chocaría
  // con el CHECK de arriba al borrar un Account con ingestas PROCESADAS.
  account            Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  // US-004: relajado a nullable por la misma razón que accountId — una
  // FALLIDA temprana no tiene banco resuelto.
  banco              String?
  nombreArchivo      String
  estado             EstadoIngesta @default(PENDIENTE)
  totalTransacciones Int?
  // US-005: conteo de filas detectadas como duplicado y NO persistidas.
  // Default 0 — histórico backfillea a 0 (semánticamente correcto: no se
  // omitió nada antes de que existiera esta detección). Additive, sin
  // backfill de datos.
  duplicadosOmitidos Int           @default(0)
  motivoFallo        String?
  creadoEn           DateTime      @default(now())
  procesadoEn        DateTime?
  transacciones      Transaccion[]

  @@index([userId])
}

model BucketPresupuesto {
  id            String        @id
  nombre        String        @unique
  // patrones (PatronClasificacion[]) DROPeado en S2: PatronClasificacion ya
  // no tiene relación directa con BucketPresupuesto — su bucket se deriva
  // vía categoria.bucket (ver design.md §1.1/§1.3).
  transacciones Transaccion[]
  categorias    Categoria[]
}

// Categoria (US-013, per-user desde US-037) — nivel más fino que Bucket;
// cada categoría pertenece a exactamente un bucket (invariante CAT-01,
// dueño real en domain/value-objects/categoria.ts vía CATEGORIA_BUCKET).
// US-037: el catálogo dejó de ser un row set global — cada usuario recibe
// su propia copia (copy-on-signup, ver catalogo-template.ts). `nombre` ya
// NO es único globalmente: la unicidad vive en (userId, nombre).
model Categoria {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id])
  nombre        String
  bucketId      String
  bucket        BucketPresupuesto     @relation(fields: [bucketId], references: [id])
  patrones      PatronClasificacion[]
  transacciones Transaccion[]

  // Clave de resolución de id para todo writer (seed, copy hook,
  // reclasificación): un usuario nunca puede tener dos categorías con el
  // mismo nombre, pero distintos usuarios sí pueden compartir un nombre.
  @@unique([userId, nombre])
  // Target del composite FK de PatronClasificacion (design.md D-06) —
  // redundante para lookups, requerido por Postgres para que la FK
  // multi-columna pueda referenciar (id, userId).
  @@unique([id, userId])
  @@index([bucketId])
}

model PatronClasificacion {
  id          String    @id @default(cuid())
  patron      String
  matchType   String
  // Slice S2: bucketId DROPeado (era redundante; el bucket ahora se DERIVA
  // vía categoria.bucket en el VO de dominio — ver design.md §1.1/§1.3).
  // categoriaId es NOT NULL desde S2: el seed de S1 pobló categoriaId en
  // todas las filas, así que la tightening es segura.
  categoriaId String
  // US-037: userId denormalizado en la fila (no solo vía categoria.userId)
  // — CA-03 exige filtrar patrones por dueño sin un join hop, y un WHERE
  // directo sobre la columna es más difícil de romper por accidente en un
  // refactor futuro que un filtro basado en join (design.md D-04).
  // Integridad: composite FK (categoriaId, userId) → Categoria(id, userId)
  // garantiza por construcción que userId = categoria.userId — nunca puede
  // divergir. Deliberadamente SIN relación `user User @relation(...)`
  // directa (design.md D-06): evita que `userId` participe en dos
  // relaciones Prisma a la vez, el único construct genuinamente riesgoso.
  userId      String
  categoria   Categoria @relation(fields: [categoriaId, userId], references: [id, userId])
  prioridad   Int

  @@index([userId])
}

model Transaccion {
  id          String             @id @default(cuid())
  ingestaId   String
  ingesta     Ingesta            @relation(fields: [ingestaId], references: [id])
  accountId   String
  account     Account            @relation(fields: [accountId], references: [id])
  fecha       DateTime
  descripcion String
  cargo       BigInt
  abono       BigInt
  bucketId    String?
  bucket      BucketPresupuesto? @relation(fields: [bucketId], references: [id])
  // Nullable para siempre (Ingreso/SinCategoria/no-match no tienen
  // categoría). onDelete SetNull: borrar una categoría NUNCA debe
  // cascade-borrar transacciones (dato de dinero). bucketId sigue siendo la
  // fuente de verdad del 50/30/20 (ver design.md §1.1).
  categoriaId String?
  categoria   Categoria?         @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  creadoEn    DateTime           @default(now())

  // US-005: acota la lectura de detección de duplicados por (accountId,
  // fecha ∈ [min,max] del batch entrante) — nunca un full-history scan.
  // Non-unique deliberadamente: un índice único abortaría el createMany
  // atómico en la primera colisión (lo OPUESTO al auto-skip de CA-03). Sin
  // índice sobre `descripcion` (rompería bajo cifrado real + filtraría
  // texto plano-adyacente en un índice, ADR-013).
  @@index([accountId, fecha])
}
